---
import { cn } from '@lib/utils';

interface Props {
  classes?: string;
}
const { classes } = Astro.props;
---

<div
  class={cn(
    // base
    'prose',
    // general text
    'prose-p:mt-2 prose-p:mb-0 prose-p:text-pretty prose-p:first:mt-0',
    // bold & italic
    'prose-strong:font-semibold prose-em:italic',
    classes,
  )}
>
  <slot />
</div>
